# smilir — Docker settings. Copy to `.env` and edit the secrets.
# `docker compose` reads this file automatically.

# Host port for the web console (http://localhost:8080)
PIPNIX_PORT=8080
PIPNIX_TIMEZONE=UTC

# ---------------------------------------------------------------- database
PIPNIX_DB_NAME=pipnix
PIPNIX_DB_USER=pipnix
PIPNIX_DB_PASS=change-me-db
PIPNIX_DB_ROOT_PASS=change-me-root

# ------------------------------------------------------------------- admin
# The first boot creates admin:admin — the usual convention. That is a weak
# password, so the console forces a new one at the first sign-in. Set a
# different PIPNIX_ADMIN_PASS if you prefer; a strong one skips the change.
PIPNIX_ADMIN_USER=admin
PIPNIX_ADMIN_PASS=

# ------------------------------------------------------------------- alerts
# PHP mail() needs an MTA/relay inside the container; leave disabled unless
# you add one (see docs/DOCKER.md#email-alerts).
PIPNIX_ALERTS_ENABLED=0
PIPNIX_ALERTS_FROM=smilir@example.com
PIPNIX_ALERTS_TO=

# ------------------------------------------------------- host user (Linux)
# Uncomment so files created by the web editor belong to you on the host:
# PIPNIX_UID=1000
# PIPNIX_GID=1000

# ------------------------------------------------------------------- updates
# The admin console can check GitHub and apply source archives. Docker keeps
# this disabled by default — rebuild the image instead.
PIPNIX_UPDATER_ENABLED=1
PIPNIX_UPDATE_REPO=qoisoctava/pipnix
PIPNIX_UPDATE_CHANNEL=branch
PIPNIX_UPDATE_BRANCH=main
# Private fork? A read-only token is safer in app/config.php, but env works:
PIPNIX_UPDATE_TOKEN=
PIPNIX_UPDATE_ALLOW_DOCKER=0
